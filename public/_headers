# Netlify response headers.

# /newhome is a staging preview — keep it out of search results.
# This backs up the noindex <meta> in newhome/index.html: the header is honored
# even for non-HTML responses and by crawlers that skip the markup.
#
# Deliberately NOT robots.txt-disallowed: a disallowed URL can't be crawled, so
# Google would never read the noindex and could still index the URL if it finds
# a link to it. Crawlable + noindex is what actually keeps it out.
/newhome
  X-Robots-Tag: noindex, nofollow, noarchive
/newhome/*
  X-Robots-Tag: noindex, nofollow, noarchive

# /testing1 is a temporary look-and-feel preview (password-gated). Same deal:
# crawlable + noindex keeps the URL out of search; it'll be removed once the
# project wraps.
/testing1
  X-Robots-Tag: noindex, nofollow, noarchive
/testing1/*
  X-Robots-Tag: noindex, nofollow, noarchive

# /internal-doc is the password-gated internal document directory. The edge
# function (netlify/edge-functions/internal-doc-auth.js) already sets
# X-Robots-Tag on every response it produces, and unauthenticated crawlers only
# ever see the 401 login page. These entries are the belt-and-braces layer for
# responses that pass through the gate.
#
# Same reasoning as above: no robots.txt Disallow. A disallowed URL can't be
# crawled, so the noindex would never be read, and the bare URL could still
# surface in search.
/internal-doc
  X-Robots-Tag: noindex, nofollow, noarchive
/internal-doc/*
  X-Robots-Tag: noindex, nofollow, noarchive
