# Where the commerce middleware lives (mock-middleware in dev).
MIDDLEWARE_BASE_URL=http://localhost:7070
MIDDLEWARE_API_TOKEN=dev-mock-token

# Signs the moox_cart cookie. Any random string in dev.
CART_COOKIE_SECRET=dev-cart-secret

# Base URL for product images returned by the middleware (paths like
# /images/akasa-1.jpg). In dev the Vite marketing site serves them.
NEXT_PUBLIC_ASSETS_BASE=http://localhost:3000

# Database: UNSET = SQLite file at data/moox.db (development default).
# SET = Postgres (production), e.g.:
# DATABASE_URL=postgres://user:pass@host:5432/moox
# SQLITE_PATH=data/moox.db
